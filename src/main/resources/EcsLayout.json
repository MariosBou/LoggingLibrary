
  {
  "$resolver": "timestamp",
  "pattern": {
    "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
    "timeZone": "UTC"
  }
  },
  {
    "$resolver": "mdc",
    "flatten": false,
    "stringified": true,
    "textblock": " ["
  },
  {
    "$resolver": "level",
    "field": "name",
    "textblock": "] "
  },
  {
    "$resolver": "message",
    "stringified": true
  }

